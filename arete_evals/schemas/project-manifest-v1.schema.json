      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "classification": {
          "enum": [
            "active",
            "incubating",
            "flagship",
            "paused",
            "archived"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        },
        "review_after_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 366
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
