            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "name",
        "purpose",
        "classification",
        "owner",
        "last_reviewed",
        "review_after_days",
        "boundaries",
        "non_goals"
      ]
