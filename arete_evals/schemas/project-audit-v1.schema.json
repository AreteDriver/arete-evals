{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "as_of",
    "project",
    "outcome",
    "automated_gates_passed",
    "certification",
    "score",
    "tests_executed",
    "revision",
    "clean",
    "gates",
    "findings",
    "input_sha256",
    "manual_review_required",
    "auditor"
  ],
  "properties": {
    "schema_version": {
      "const": "project-audit-v1"
    },
    "profile": {
      "const": "deterministic-v1"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "enum": [
        "FAIL",
        "PASS WITH CONDITIONS"
      ]
    },
    "automated_gates_passed": {
      "type": "boolean"
    },
    "certification": {
      "const": "UNKNOWN"
    },
    "score": {
      "type": "null"
    },
    "tests_executed": {
      "const": false
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "clean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Identity",
        "Boundary",
        "Canonical Source",
        "Current Reality",
        "Execution Direction",
        "Source Coherence",
        "Safety and Sensitivity"
      ],
      "properties": {
        "Identity": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        },
        "Boundary": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        },
        "Canonical Source": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        },
        "Current Reality": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        },
        "Execution Direction": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        },
        "Source Coherence": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        },
        "Safety and Sensitivity": {
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "UNKNOWN"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate",
          "status",
          "code",
          "message",
          "evidence"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WARNING",
              "UNKNOWN"
            ]
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "manual_review_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "implementation_sha256",
        "manifest_schema_sha256"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "implementation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_schema_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
